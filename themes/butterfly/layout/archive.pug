extends includes/layout.pug

block content
  - const allPosts = site.posts.sort('date', -1).toArray()
  - const yearCounts = {}
  - allPosts.forEach(article => { const year = date(article.date, 'YYYY'); yearCounts[year] = (yearCounts[year] || 0) + 1 })
  - const years = Object.keys(yearCounts).sort((a, b) => Number(b) - Number(a))
  - const selectedYear = page.year ? String(page.year) : ''
  - const selectedMonth = page.month ? String(page.month).padStart(2, '0') : ''
  - const scopeTitle = selectedYear ? selectedYear + ' 年' + (selectedMonth ? ' ' + selectedMonth + ' 月' : '') : '全部文章'
  - const scopeCount = allPosts.filter(article => (!selectedYear || date(article.date, 'YYYY') === selectedYear) && (!selectedMonth || date(article.date, 'MM') === selectedMonth)).length
  - const groups = []
  - page.posts.each(article => { const year = date(article.date, 'YYYY'); let group = groups[groups.length - 1]; if (!group || group.year !== year) { group = { year, posts: [] }; groups.push(group) } group.posts.push(article) })
  - const archiveRoot = config.archive_dir.replace(/\/$/, '') + '/'
  #archive
    .archive-directory
      header.archive-intro
        .archive-intro-copy
          p.archive-eyebrow 时光年鉴
          h2 文章归档
          p.archive-description 从最近的记录出发，沿年份回看技术与思考。
        dl.archive-stats
          div
            dt 文章
            dd= allPosts.length
          div
            dt 年份
            dd= years.length
      nav.archive-years(aria-label='按年份浏览')
        a(href=url_for(archiveRoot) class=!selectedYear ? 'is-current' : '' aria-current=!selectedYear ? 'page' : false) 全部
        each year in years
          a(href=url_for(archiveRoot + year + '/') class=selectedYear === year ? 'is-current' : '' aria-current=selectedYear === year && !selectedMonth ? 'page' : false)
            span= year
            span.archive-year-count= yearCounts[year]
      .archive-scope
        h2= scopeTitle
        p= '共 ' + scopeCount + ' 篇 · 第 ' + page.current + ' / ' + page.total + ' 页'
      .archive-groups
        each group in groups
          details.archive-year-section(open aria-labelledby='archive-year-' + group.year)
            summary.archive-year-heading
              h3(id='archive-year-' + group.year)= group.year
              span= '全年 ' + yearCounts[group.year] + ' 篇'
              span.archive-year-toggle(aria-hidden='true')
            ol.archive-entries
              each article in group.posts
                - const category = article.categories.data[article.categories.data.length - 1]
                - const cover = article.cover_thumbnail || article.cover
                li.archive-entry(class=!article.cover ? 'no-cover' : '')
                  if article.cover
                    a.archive-entry-cover(href=url_for(article.path) tabindex='-1' aria-hidden='true')
                      img(src=url_for(cover) alt='' onerror=`this.onerror=null;this.src='${url_for(theme.error_img.post_page)}'`)
                  .archive-entry-body
                    time.archive-entry-date(datetime=date_xml(article.date) title=date(article.date, 'YYYY-MM-DD'))= date(article.date, 'MM-DD')
                    a.archive-entry-title(href=url_for(article.path))= article.title || _p('no_title')
                    if category
                      a.archive-entry-category(href=url_for(category.path))= category.name
      include includes/pagination.pug
