script.
  function panguFn () {
    const applySpacing = () => {
      if (!{theme.pangu.field === 'post'}) pangu.spacingElementById('article-container')
      else pangu.autoSpacingPage()
    }
    if (typeof pangu === 'object') applySpacing()
    else {
      getScript('!{url_for(theme.CDN.pangu)}')
        .then(applySpacing)
    }
  }

  function panguInit () {
    if (!{theme.pangu.field === 'post'}){
      GLOBAL_CONFIG_SITE.isPost && panguFn()
    } else {
      panguFn()
    }
  }

  document.addEventListener('DOMContentLoaded', panguInit)
