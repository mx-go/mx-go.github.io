#page
  .category-lists
    padding: 1rem 0 1.5rem

    +maxWidth768()
      padding: 0

    .category-title
      font-size: 2.57em

      +maxWidth768()
        font-size: 2em

    .category-list
      a
        color: var(--font-color)

        &:hover
          color: $text-hover

      .category-list-count
        margin-left: .4rem
        color: $theme-meta-color

        &:before
          content: '('

        &:after
          content: ')'

    ul
      margin-top: .4rem
      padding: 0 0 0 1rem
      list-style: none
      counter-reset: li

      ul
        padding-left: .2rem

      li
        position: relative
        margin: .3rem 0
        padding: .12em .4em .12em 1.4em

        &:before
          position: absolute
          left: 0
          cursor: pointer
          transition: all .3s ease-out
          $w = .43em
          top: .7em
          width: w = $w
          height: h = w
          border: .5 * w solid $light-blue
          border-radius: w
          background: transparent
          content: ''
          // line-height: h

        &:hover
          &:before
            border-color: $pseudo-hover

#page .category-directory
  --category-heading: #263b53
  --category-muted: #68798c
  --category-line: #e8edf3
  padding: 12px 4px

  .category-directory-intro
    display: flex
    align-items: center
    justify-content: space-between
    gap: 24px
    padding-bottom: 28px

  .category-directory-eyebrow
    margin: 0 0 6px
    color: #3978c5
    font-size: 12px
    font-weight: 600
    letter-spacing: 3px

  h1
    margin: 0 0 10px
    color: var(--category-heading)
    font-size: 32px
    line-height: 1.35

  .category-directory-description
    margin: 0
    color: var(--category-muted)
    font-size: 14px

  .category-directory-stats
    display: flex
    flex-shrink: 0
    gap: 30px
    margin: 0
    text-align: center

    dt
      color: var(--category-muted)
      font-size: 12px

    dd
      margin: 0
      color: var(--category-heading)
      font-size: 28px
      font-weight: 600
      line-height: 1.5
      font-variant-numeric: tabular-nums

  .category-directory-nav
    display: flex
    flex-wrap: wrap
    gap: 8px
    margin-bottom: 28px
    padding-top: 22px
    border-top: 1px solid var(--category-line)

    a
      padding: 6px 13px
      border: 1px solid var(--category-line)
      border-radius: 8px
      color: var(--category-muted)
      font-size: 13px
      transition: color .2s, border-color .2s

      &:hover, &:focus-visible
        border-color: #3978c5
        color: #3978c5

  .category-directory-grid
    display: grid
    grid-template-columns: repeat(2, minmax(0, 1fr))
    gap: 22px

  .category-card
    position: relative
    overflow: hidden
    padding: 24px
    border: 1px solid var(--category-line)
    border-radius: 16px
    background: linear-gradient(145deg, var(--category-tint), var(--card-bg) 65%)
    scroll-margin-top: 90px

    &:before
      position: absolute
      top: 0
      left: 24px
      width: 38px
      height: 3px
      border-radius: 0 0 4px 4px
      background: var(--category-accent)
      content: ''

    &:last-child:nth-child(odd)
      grid-column: 1 / -1

      .category-topics
        display: grid
        grid-template-columns: repeat(2, minmax(0, 1fr))
        column-gap: 28px

  .category-card-heading
    display: flex
    align-items: flex-start
    gap: 13px
    margin-bottom: 18px

  .category-card-icon
    display: flex
    width: 42px
    height: 42px
    flex-shrink: 0
    align-items: center
    justify-content: center
    border: 1px solid var(--category-line)
    border-radius: 12px
    background: var(--card-bg)
    color: var(--category-accent)
    font-size: 18px

  .category-card-title
    flex: 1
    min-width: 0

    h2
      margin: 1px 0 7px
      font-size: 20px
      line-height: 1.4

      a
        color: var(--category-heading)

        &:hover
          color: var(--category-accent)

    p
      margin: 0
      color: var(--category-muted)
      font-size: 12px
      line-height: 1.8

  .category-card-total
    display: flex
    flex-shrink: 0
    align-items: baseline
    gap: 3px
    color: var(--category-accent)
    font-size: 11px

    strong
      font-size: 22px
      font-weight: 600
      line-height: 1.4
      font-variant-numeric: tabular-nums

  .category-topics
    margin: 0
    padding: 0
    list-style: none

    li
      margin: 0
      padding: 0
      list-style: none

      &:not(:last-child)
        border-bottom: 1px solid var(--category-line)

    a
      display: flex
      min-height: 45px
      align-items: center
      justify-content: space-between
      gap: 12px
      border-radius: 6px
      color: var(--font-color)
      font-size: 14px
      transition: color .2s, background .2s

      &:hover, &:focus-visible
        background: var(--category-tint)
        color: var(--category-accent)

  .category-topic-meta
    display: flex
    flex-shrink: 0
    align-items: center
    gap: 12px
    padding-right: 4px

  .category-topic-count
    min-width: 24px
    padding: 0 6px
    border-radius: 5px
    background: var(--category-tint)
    color: var(--category-accent)
    font-size: 12px
    line-height: 24px
    text-align: center
    font-variant-numeric: tabular-nums

  .category-topic-arrow
    color: var(--category-muted)
    font-size: 20px

  .category-directory-footer
    display: flex
    flex-wrap: wrap
    justify-content: space-between
    gap: 12px
    margin-top: 28px
    padding-top: 20px
    border-top: 1px solid var(--category-line)
    color: var(--category-muted)
    font-size: 12px

    p
      margin: 0

  .category-directory-more
    display: flex
    gap: 18px

  a:focus-visible
    outline: 2px solid var(--category-accent, #3978c5)
    outline-offset: 4px

  @media (max-width: 680px)
    padding: 0

    .category-directory-intro
      align-items: flex-start
      flex-direction: column
      gap: 20px

    h1
      font-size: 28px

    .category-directory-stats
      gap: 32px
      text-align: left

      dd
        font-size: 25px

    .category-directory-grid
      grid-template-columns: minmax(0, 1fr)
      gap: 16px

    .category-card
      padding: 20px
      border-radius: 12px

      &:last-child:nth-child(odd) .category-topics
        grid-template-columns: minmax(0, 1fr)

    .category-card-title h2
      font-size: 18px

[data-theme='dark'] #page .category-directory
  --category-heading: #dbe5f1
  --category-muted: #9baabd
  --category-line: #303a46

  .category-card
    background: linear-gradient(145deg, #202a37, var(--card-bg) 65%)

  .category-topic-count, .category-topics a:hover, .category-topics a:focus-visible
    background: #273342
    color: #b8cef0

#category .category-breadcrumb
  display: flex
  flex-wrap: wrap
  gap: 8px
  margin-bottom: 14px
  color: var(--font-color)
  font-size: 13px

  a
    color: #3978c5
